<style>
    .search-btn {
        background: #fe424d;
        color: #fff;
        border-radius: 25px;
        padding: 0.5rem 1rem;
        border: none;
        white-space: nowrap;
    }
    
    .search-btn:hover {
        background: #fe424d;
        color: #fff;
    }
    
    .search-btn i {
        margin-right: 0.5rem;
    }
    
    .search-inp {
        border-radius: 25px;
        padding: 0.5rem 1rem;
        font-size: 1rem;
        min-width: 220px;
    }
    
    .navbar-right {
        align-items: center;
    }
    
    .auth-link {
        white-space: nowrap;
    }
    /* ===== MOBILE ===== */
    
    @media (max-width: 767px) {
        .navbar {
            padding: 0.7rem 0;
        }
        .navbar-brand {
            font-size: 1.25rem;
        }
        .navbar-collapse {
            padding-top: 1rem;
            padding-bottom: 0.5rem;
        }
        .navbar-nav {
            width: 100%;
        }
        .navbar-nav .nav-link {
            padding: 0.7rem 0.75rem;
            border-radius: 8px;
        }
        .navbar-nav .nav-link:hover {
            background-color: #f5f5f5;
        }
        /* Search */
        .search-form {
            width: 100%;
            margin: 0.5rem 0;
        }
        .search-inp {
            min-width: 0;
            width: 100%;
        }
        .search-btn {
            padding: 0.5rem 1rem;
        }
        /* Right side */
        .navbar-right {
            margin-top: 0.5rem;
            align-items: stretch;
        }
        .navbar-right .nav-link {
            width: 100%;
            text-align: left;
        }
        /* Login / Signup / Logout */
        .auth-link {
            margin-top: 0.15rem;
        }
        .logout-link {
            color: #fe424d !important;
        }
        /* Hamburger */
        .navbar-toggler {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 0.4rem 0.6rem;
        }
        .navbar-toggler:focus {
            box-shadow: none;
        }
    }
    /* ===== VERY SMALL PHONES ===== */
    
    @media (max-width: 480px) {
        .search-btn span {
            display: none;
        }
        .search-btn {
            width: 45px;
            padding: 0.5rem;
        }
        .search-btn i {
            margin-right: 0;
        }
        .search-inp {
            font-size: 0.9rem;
        }
    }
</style>


<nav class="navbar navbar-expand-md bg-white border-bottom border-2 border-dark-subtle sticky-top">

    <div class="container-fluid px-3">

        <!-- Logo -->

        <a class="navbar-brand" href="/listings">
            <i class="fa-regular fa-compass"></i>
        </a>


        <!-- Mobile Hamburger -->

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>


        <!-- Navbar Content -->

        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

            <!-- Explore -->

            <div class="navbar-nav">

                <a class="nav-link" href="/listings">
                    Explore
                </a>

            </div>


            <!-- Search -->

            <div class="navbar-nav mx-auto">

                <form class="d-flex search-form" role="search">

                    <input class="form-control search-inp" type="search" placeholder="Search destination" />

                    <button class="btn search-btn" type="submit">

                        <i class="fa-solid fa-magnifying-glass"></i>

                        <span>Search</span>

                    </button>

                </form>

            </div>


            <!-- Right Side -->

            <div class="navbar-nav navbar-right">

                <a class="nav-link" href="/listings/new">
                    Airbnb your home
                </a>


                <!-- When user is NOT logged in -->

                <% if (typeof currUser === "undefined" || !currUser) { %>

                    <a class="nav-link auth-link" href="/signup">
                        Sign up
                    </a>

                    <a class="nav-link auth-link" href="/login">
                        Log in
                    </a>

                    <% } %>


                        <!-- When user IS logged in -->

                        <% if (typeof currUser !== "undefined" && currUser) { %>

                            <a class="nav-link logout-link" href="/logout">
                        Log out
                    </a>

                            <% } %>

            </div>

        </div>

    </div>

</nav>